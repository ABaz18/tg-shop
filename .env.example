BOT_TOKEN=123456:ABC
# Optional. If empty, title is taken from BotFather name (getMe).
BOT_NAME=
# Comma-separated Telegram user IDs. These accounts cannot be demoted.
OWNER_IDS=123456789

# HMAC for invoice payloads and signed callback extras
# python -m app.gen_secret
SECRET_KEY=change-me-to-64-random-bytes

DATABASE_URL=postgresql+asyncpg://shop:shop@localhost:5432/shop
REDIS_URL=redis://localhost:6379/0

# polling | webhook
UPDATE_MODE=polling
WEBHOOK_URL=https://example.com/webhook
WEBHOOK_SECRET=change-me-webhook-secret
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Optional chat for critical alerts (purchases, tickets, low stock)
ALERT_CHAT_ID=

LOG_LEVEL=INFO
ENVIRONMENT=production
